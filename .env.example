# Copy this file to `.env` (already gitignored) and fill in real values.
# `.env` is loaded automatically on server startup (src/core/xarm_api_server.py)
# via python-dotenv. Values already exported in your shell/environment always
# take precedence over this file.

# Required to enable the natural-language "Language Command" card.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Claude model used to interpret commands.
# Default: claude-haiku-4-5
# XARM_LLM_MODEL=claude-haiku-4-5
